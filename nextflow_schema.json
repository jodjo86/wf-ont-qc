{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/jodjo86/wf-ont-qc/main/nextflow_schema.json",
    "title": "wf-ont-qc pipeline parameters",
    "description": "Merge Nanopore FASTQ by barcode, QC/preprocess with fastplong, and produce a run-level fastplong summary report",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": [
                "input"
            ],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory containing one sub-directory per barcode (e.g. fastq_pass/barcode01/*.fastq.gz), as produced by MinKNOW/Dorado basecalling.",
                    "fa_icon": "fas fa-folder-open"
                },
                "out_dir": {
                    "type": "string",
                    "default": "output",
                    "format": "directory-path",
                    "description": "Output directory where the results will be saved.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "qc_options": {
            "title": "QC options",
            "type": "object",
            "fa_icon": "fas fa-filter",
            "properties": {
                "fastplong_trim_front": {
                    "type": "integer",
                    "default": 20,
                    "description": "Number of bases to trim from the front (5') of each read.",
                    "fa_icon": "fas fa-cut"
                },
                "fastplong_trim_tail": {
                    "type": "integer",
                    "default": 20,
                    "description": "Number of bases to trim from the tail (3') of each read.",
                    "fa_icon": "fas fa-cut"
                },
                "fastplong_disable_adapter_trimming": {
                    "type": "boolean",
                    "default": true,
                    "description": "Disable adapter trimming.",
                    "fa_icon": "fas fa-ban"
                },
                "fastplong_discard_chimeric_reads": {
                    "type": "boolean",
                    "default": true,
                    "description": "Discard chimeric reads.",
                    "fa_icon": "fas fa-unlink"
                },
                "fastplong_mean_qual": {
                    "type": "integer",
                    "default": 14,
                    "description": "Minimum mean quality score required to keep a read.",
                    "fa_icon": "fas fa-star-half-alt"
                },
                "fastplong_length_required": {
                    "type": "integer",
                    "default": 300,
                    "description": "Minimum read length required to keep a read.",
                    "fa_icon": "fas fa-ruler-horizontal"
                },
                "fastplong_length_limit": {
                    "type": "integer",
                    "default": 10000,
                    "description": "Maximum read length allowed (0 for no limit).",
                    "fa_icon": "fas fa-ruler-horizontal"
                },
                "sequencing_summary": {
                    "type": "string",
                    "format": "file-path",
                    "description": "MinKNOW/Dorado sequencing_summary*.txt file. If left empty, it is auto-detected in the parent directory of --input (there must be exactly one match).",
                    "fa_icon": "fas fa-file-alt"
                },
                "run_name": {
                    "type": "string",
                    "description": "Name used for the run-level report. If left empty, it is read from the protocol_group_id field of final_summary*.txt in the parent directory of --input (there must be exactly one match).",
                    "fa_icon": "fas fa-signature"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "properties": {
                "help": {
                    "type": "boolean",
                    "default": false,
                    "description": "Display help text.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/qc_options"
        },
        {
            "$ref": "#/definitions/generic_options"
        }
    ]
}
